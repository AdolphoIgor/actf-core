FROM rayproject/ray:2.40.0-py311-gpu

USER root

# 1. Install system toolchain (Includes cmake and g++ for C++ extensions)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl gcc g++ cmake procps && apt-get clean && rm -rf /var/lib/apt/lists/*

# 2. Install uv binary globally
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR="/usr/local/bin" sh

# 3. Target Ray's container Python environment
ENV UV_SYSTEM_PYTHON=1

WORKDIR /home/ray/workspace

# 4. Copy workspace manifests FIRST to leverage Docker layer caching
COPY ./pyproject.toml ./uv.lock* ./
COPY ./2-data-prep/pyproject.toml ./2-data-prep/
COPY ./3-model-training/pyproject.toml ./3-model-training/
COPY ./4-model-eval/pyproject.toml ./4-model-eval/

# 5. Pre-install GPU-specific third-party dependencies
RUN uv pip install --no-cache \
    -r 2-data-prep/pyproject.toml --extra gpu \
    -r 3-model-training/pyproject.toml \
    -r 4-model-eval/pyproject.toml

# 6. Copy application code FIRST
COPY ./2-data-prep/ ./2-data-prep/
COPY ./3-model-training/ ./3-model-training/
COPY ./4-model-eval/ ./4-model-eval/

RUN chown -R ray:users /home/ray/workspace

USER ray