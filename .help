# RESTART THE ENVIRONMENT TO INGEST-TO-BRONZE
docker exec -it actf-core-airflow-webserver python -c "
import os, boto3
s3 = boto3.resource('s3', endpoint_url=os.getenv('MINIO_ENDPOINT', 'http://minio-storage:9000'), aws_access_key_id='minioadmin', aws_secret_access_key='minioadmin')
bucket = s3.Bucket('company-ai-datalake')
bucket.objects.all().delete()
print('SUCCESS: MinIO bucket company-ai-datalake cleared.')
"
